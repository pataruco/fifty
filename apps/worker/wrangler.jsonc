{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fifty",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "routes": [{ "pattern": "fifty.pataruco.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/public",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true },
  "secrets": {
    "required": ["INVITE_WORDS", "GUEST_KEY", "JOIN_EMAIL"]
  }
}
